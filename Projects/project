import React from 'react';

const DateTime = () => {
  const now = new Date();
  const formattedDate = now.toLocaleString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  });

  return (
    <div>
      {formattedDate}
    </div>
  );
};

export default DateTime;

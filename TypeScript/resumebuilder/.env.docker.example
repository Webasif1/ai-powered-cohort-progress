# Copy to `.env.docker` and fill in. That file is git-ignored by the existing
# `.env*` rule and excluded from the image by .dockerignore, so real values
# never reach the repo or an image layer.
#
#   cp .env.docker.example .env.docker

# ---------------------------------------------------------------------------
# Database — pick ONE
# ---------------------------------------------------------------------------

# (a) Your own cluster, e.g. Atlas. This is the default path. Paste the same
#     connection string you use in .env.local. Remember to allow your current
#     IP in the Atlas network access list, or connections time out.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/resumebuilder

# (b) The throwaway local database in docker-compose.yml. Use this value
#     instead, and start the stack with:
#         docker compose --profile local-db up --build
# MONGO_URI=mongodb://mongo:27017/resumebuilder

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Signs the session JWT. Any long random string; changing it invalidates every
# existing session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Google Gemini key for the AI writing features. The app runs without it, but
# every /api/ai/* route will fail until it is set.
GEMINI_API_KEY=replace-me

# Copy to `.env.docker` and fill in. That file is git-ignored by the existing
# `.env*` rule and excluded from the image by .dockerignore.
#
#   cp .env.docker.example .env.docker
#
# MONGO_URI is NOT set here — docker-compose.yml points it at the `mongo`
# service. Override it only if you want to use an external cluster instead.

# Signs the session JWT. Any long random string; changing it invalidates every
# existing session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Google Gemini key for the AI writing features. The app runs without it, but
# every /api/ai/* route will fail until it is set.
GEMINI_API_KEY=replace-me

# Copy to `.env.local` for local development:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored by the `.env*` rule. For Docker, use
# `.env.docker.example` instead — same variables, different host for the
# database.
#
# All three are validated at boot by src/lib/env.ts. A missing or malformed
# value stops the server with a named error rather than failing later at the
# first request that happens to need it.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Must start with mongodb:// or mongodb+srv://.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/resumebuilder

# Signs the session JWT. Minimum 32 characters — the schema rejects shorter.
# Changing it invalidates every existing session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Google Gemini key. Every /api/ai/* route needs it.
GEMINI_API_KEY=replace-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Error reporting. Leave unset and Sentry stays completely inert — the SDK is
# never even imported. Set it in production to get server errors off stdout.
# SENTRY_DSN=
